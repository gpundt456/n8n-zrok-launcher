
# ==========================================
# n8n + zrok Launcher Configuration
# ==========================================

# Path to your n8n executable.
# Leave as n8n.cmd if installed globally.
N8N_CMD=n8n.cmd

# Path to your zrok executable.
# Leave as zrok if it's available in PATH.
ZROK_EXE=zrok

# ==========================================
# Network Configuration
# ==========================================

# Local n8n server port
N8N_PORT=5678

# Local webhook filtering proxy port
WEBHOOK_PROXY_PORT=8765

# ==========================================
# Telegram Integration (Optional)
# ==========================================

# Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=

# The webhook path/ID used by your n8n workflow
N8N_WEBHOOK_ID=

# ==========================================
# Startup Settings
# ==========================================

# Maximum startup time in seconds
N8N_START_TIMEOUT=60

# Maximum time to detect the zrok URL
ZROK_URL_TIMEOUT=90

# Maximum webhook request size in bytes (16 MB)
MAX_WEBHOOK_BODY_BYTES=16777216
